rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products catalog: readable by all visitors; writable by anyone for live admin store management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: readable by all visitors
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: readable and creatable by customers and admins for live tracking
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if !(orderId in ['ord-1001', 'ord-1002']);
      allow delete: if true;
    }

    // Store settings: readable by all visitors
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // User accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Delivery zones and coupons
    match /deliveryZones/{zoneId} {
      allow read: if true;
      allow write: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
